doctype html
html(lang="en")
    head
        title [Kiwisbot] - #{user.display_name}

        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")

        link(rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous")
        link(rel="stylesheet" href="../rootpage.css" crossorigin="anonymous")

        script(src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous")
        script(src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous")
        script(src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous")
        script(type="text/javascript" src="/socket.io/socket.io.js" crossorigin="anonymous")

    body.themed-page
        div(class="container")
            div(class="container-fluid")
                div(id="messages")
                    if flash.error
                        div(class="alert alert-danger" role="alert") #{flash.error}
                    if flash.warning
                        div(class="alert alert-warning" role="alert") #{flash.warning}
                    if flash.success
                        div(class="alert alert-success" role="alert") #{flash.success}
                    if auth_error
                        div(class="alert alert-warning" role="alert") #{auth_error}

            div(class="row")
                div(class="col")
                    div(class="card")
                        div(class="card-body")
                            img(src='../mike.png' width="100%")
                            h1(class="card-title")  Kiwisbot
                div(class="col")
                    div(class="card")
                        div(class="card-body") Logged in as #{user.display_name}
                            p: a(class="btn btn-primary" href='/') Back to Root
                    div(class="card")
                        div(class="card-body") 
                            h5(class="card-title") Kiwisbot Info:
                            p A twitch Bot Dashboard for Simple Bot Control.
                            p Desgined by Mikethemadkiwi for Select Users.

            div(class="row")
                div(class="col")
                    div(class="card")
                        div(class="card-body")
                            h5(class="card-title") <img src='#{user.profile_image_url}' width="50px" /> User Info: #{user.display_name}
                            h6(class="card-subtitle mb-2 text-muted") User ID: #{user.id}
                            h6(class="card-subtitle mb-2 text-muted") Email: #{user.email}
                            h6(class="card-subtitle mb-2 text-muted") Type: #{user.type}
                            h6(class="card-subtitle mb-2 text-muted") Broadcaster Type: #{user.broadcaster_type}
                            h6(class="card-subtitle mb-2 text-muted") View Count: #{user.view_count}
                            h6(class="card-subtitle mb-2 text-muted") Created At: #{user.created_at}
                            div(class="card-text") #{user.description}  

            div(class="row")
                div(class="col")       
                    div(class="card")
                        div(class="card-body")
                            h5(class="card-title") Stream Information
                            h6(class="card-subtitle mb-2 text-muted") Stream Title: #{channel.title}
                            h6(class="card-subtitle mb-2 text-muted") Game: #{channel.game_name}
                            h6(class="card-subtitle mb-2 text-muted") Viewers: #{channel.view_count}     

            div(class="row")
                div(class="col")
                    div(class="card2")
                        div(class="card-body")
                            h5(class="card-title") Bot Information
                            div Bot Status:
                                if config == -1
                                    p: a(class="btn btn-primary"  href='/startbot') Start Bot 
                                    p Bot Launches as Master User. Not as Your Username. so All chat will appear as that user. all information it uses will be gained using YOUR oauth token.
                                else if config == 0
                                    h6(class="card-subtitle mb-2 text-muted") Joined: #{user.id}  

                    if config == 0
                        div(class="row")
                            div(class="col")
                                div(class="card2")
                                    div(class="card-body")
                                        h5(class="card-title") Bot Control
                                        p: a(class="btn btn-primary" href="/stopbot") Stop Bot.
                                        h6(class="card-subtitle mb-2 text-muted") Say In Chat.
                                        p: a(class="btn btn-primary" href='/bofhinchat') BOFH
                                        h6(class="card-subtitle mb-2 text-muted") Ad System.
                                        p AD STATS WILL GO HERE
                                        p: a(class="btn btn-primary" href='/runads30') Run Ads (30s)
                                            a(class="btn btn-primary" href='/runads60') Run Ads (60s)
                                            a(class="btn btn-primary" href='/runads90') Run Ads (90s)

            div(class="row")
                div(class="col")
                    div(class="card")
                        div(class="card-body")
                            h5(class="card-title") Token Information
                            div Token Type: #{token.token_type} 
                            div Token: Expires in #{token.expires_in} seconds                             
                            div Access token (Hover to reveal)
                                    div(class="spoiler") #{token.access_token}
                            div Refresh token (Hover to reveal)
                                    div(class="spoiler") #{token.refresh_token}
                                    
            div(class="row")
                div(class="col")
                    div(class="card")
                        div(class="card-body")
                            p: a(class="btn btn-primary" href='/kiwisbot/') Refresh